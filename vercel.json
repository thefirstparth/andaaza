{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/poster", "destination": "/" }
  ],
  "redirects": [
    { "source": "/andaaza", "destination": "/", "permanent": true },
    { "source": "/andaaza/poster", "destination": "/poster", "permanent": true },
    { "source": "/consensus", "destination": "/", "permanent": true }
  ],
  "functions": {
    "api/consensus.js": { "includeFiles": "config/consensus.json", "maxDuration": 60 },
    "api/why-test.js": { "includeFiles": "config/consensus.json", "maxDuration": 60 }
  },
  "headers": [
    { "source": "/", "headers": [{ "key": "cache-control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
